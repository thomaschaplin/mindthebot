{
  "name": "mindthebot",
  "version": "0.1.0",
  "description": "Mind the bot: measure whether AI code review comments on GitHub pull requests actually get acted on.",
  "license": "MIT",
  "author": "Thomas Chaplin",
  "type": "module",
  "bin": {
    "mindthebot": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-dist": "npm run build && git diff --exit-code -- action/dist"
  },
  "keywords": [
    "github",
    "code-review",
    "ai",
    "claude",
    "metrics",
    "developer-productivity"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "commander": "^15.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "hot-shots": "^18.0.1"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
